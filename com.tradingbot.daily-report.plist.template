<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the launchd daily-report agent.
  Do NOT put real credentials here. `./setup_daily.sh install` renders this
  template into a local (git-ignored) plist, substituting __PROJECT_DIR__ and
  injecting REPORT_EMAIL_* from your .env file.
-->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__PROJECT_DIR__/.venv_trading/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>REPORT_EMAIL_FROM</key>
		<string></string>
		<key>REPORT_EMAIL_PASSWORD</key>
		<string></string>
		<key>REPORT_EMAIL_TO</key>
		<string></string>
	</dict>
	<key>Label</key>
	<string>com.tradingbot.daily-report</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PROJECT_DIR__/.venv_trading/bin/python</string>
		<string>__PROJECT_DIR__/daily_report.py</string>
	</array>
	<key>StandardErrorPath</key>
	<string>__PROJECT_DIR__/logs/daily_report.stderr.log</string>
	<key>StandardOutPath</key>
	<string>__PROJECT_DIR__/logs/daily_report.stdout.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>__PROJECT_DIR__</string>
</dict>
</plist>
