.venv/
.venv_new/
.venv_trading/

# Python
__pycache__/
*.pyc

# IDE
.idea/

# Generated
logs/
reports/

# State
.alpaca_state.json

# Claude — keep the multi-agent skill definitions, drop everything else
.claude/*
!.claude/skills/
.DS_Store
