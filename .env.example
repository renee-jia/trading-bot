# Copy to .env and fill in your own values. .env is git-ignored — never commit it.

# --- Alpaca (paper or live trading) ---
# Create keys at https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your-alpaca-key-id
ALPACA_SECRET_KEY=your-alpaca-secret-key
ALPACA_API_BASE_URL=https://paper-api.alpaca.markets/v2

# Live-trading safety (only relevant when running with --live)
# ALPACA_ALLOW_LIVE=1
# ALPACA_MAX_NOTIONAL=0

# --- Daily report email (optional) ---
# Gmail app password: https://myaccount.google.com/apppasswords
REPORT_EMAIL_FROM=your-gmail@gmail.com
REPORT_EMAIL_PASSWORD=your-16-char-app-password
REPORT_EMAIL_TO=recipient@example.com

# --- Optional: news/earnings/economic skills (FMP API) ---
# FMP_API_KEY=your-fmp-key

# --- Optional: covered-call advisor (daily report section) ---
# Personal share counts; section is skipped when unset.
# CC_POSITIONS=META:210,GOOGL:1000

# AI 持有标的 Sell Put 方案 — fixed watch list for the daily put-entry plan.
# Defaults to AVGO,MSFT,MU,QCOM,MRVL,ASML,LRCX,CDNS,VRT,ANET,PLTR + NVDA,TSM,AMD,AMAT,KLAC,ORCL,SNPS
#   + GOOGL,META,AMZN,STX,SNDK,CRWD,CRDO,COHR (AI Portfolio core + watch names)
# AI_PUT_WATCH=AVGO,MSFT,MU,QCOM,MRVL

# AI Portfolio — separately watched core list (report section + email block).
# Defaults to NVDA,AVGO,GOOGL,META,TSM,MU,AMAT,ORCL,ANET,SNPS
# AI_PORTFOLIO=NVDA,AVGO,GOOGL,META
# Watch tier shown under the core tables (candidates to promote).
# Defaults to ASML,KLAC,MSFT,AMZN,VRT,STX,SNDK,PLTR,CRWD,CRDO,COHR
# AI_PORTFOLIO_WATCH=ASML,KLAC,VRT

# Option chains come from Alpaca when ALPACA_* keys exist (Yahoo chains are
# unreliable from the cloud job). Set to force the Yahoo path:
# OPTION_DATA_SOURCE=yfinance

# --- Separate $400k cash-entry plan (report only; cumulative confirmed spend) ---
# Update both after actual purchases; these do not place orders.
# CASH_PLAN_DEPLOYED=0
# CASH_PLAN_CAPITAL_AS_OF=2026-09-08
